<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "PhotoCraft with SGL Tools" edition of Info.plist.in (packaging/macos/package.sh selects it
     when SGL_EDITION is set). Same template substitutions: @VERSION@, @SHORT_VERSION@, @BUILD_SHA@.

     What differs from the upstream bundle, and why: the identifier, the names, and how `.pcraft`
     is declared. The identifier is what LaunchServices keys on, so the two products get their own
     document window, their own preferences (see apps/photocraft/src/app_dirs.rs), their own
     single-instance handling and separate "Open With" entries instead of merging into one app.
     Everything else — executable name, icon, minimum system version, localizations, the custom
     PhotoCraftVersion keys — is identical to upstream, which is what makes the two plists easy to
     keep in step. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- UI translations are embedded in Rust; declare them for AppKit's system dialogs.
       Keep in sync with LANGUAGES in crates/ui-egui/src/i18n/mod.rs. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ja</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
    <string>es</string>
    <string>ru</string>
    <string>uk</string>
    <string>sr</string>
    <string>cs</string>
    <string>fr</string>
    <string>id</string>
    <string>ko</string>
    <string>pl</string>
    <string>de</string>
    <string>pt-BR</string>
    <string>el</string>
    <string>nl</string>
    <string>it</string>
    <string>hu</string>
    <string>tr</string>
    <string>vi</string>
    <string>sv</string>
    <string>fi</string>
    <string>da</string>
    <string>nb</string>
  </array>
  <!-- Apple recommends a CFBundleName of 15 characters or fewer (it is what the menu bar shows);
       this product name is longer, so the menu bar may abbreviate it on a narrow display. The
       full name is what Finder, the DMG volume and the installer show, which is the point of the
       edition, so the recommendation is accepted rather than the name shortened. -->
  <key>CFBundleDisplayName</key>
  <string>PhotoCraft with SGL Tools</string>
  <key>CFBundleName</key>
  <string>PhotoCraft with SGL Tools</string>
  <key>CFBundleExecutable</key>
  <string>PhotoCraft</string>
  <!-- Not ai.storyteller.photocraft: two bundles with one identifier would be the same app to
       LaunchServices, whichever was registered last. This is the macOS half of the identity in
       crates/ui-egui/src/os_window.rs and apps/photocraft/src/app_dirs.rs. -->
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.photocraft.sgl</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>PhotoCraftVersion</key>
  <string>@VERSION@</string>
  <key>PhotoCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>PhotoCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the PhotoCraft authors. MIT OR Apache-2.0.</string>

  <!-- No UTExportedTypeDeclarations here on purpose: `ai.storyteller.photocraft.document` (.pcraft)
       belongs to the upstream app, and a second bundle exporting the same UTI would be LaunchServices
       choosing between two owners of one type — exactly the default-handler fight this edition must
       not start. It is declared as imported below instead, and the document type below is ranked
       Alternate, so "PhotoCraft with SGL Tools" appears in "Open With" for .pcraft without ever
       taking the default from the installed upstream app. When only this edition is installed, the
       user picks it once (Get Info, or "Open With" then Always Open With). -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.photocraft.document</string>
      <key>UTTypeDescription</key>
      <string>PhotoCraft Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>pcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-photocraft</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.photocraft.ora</string>
      <key>UTTypeDescription</key>
      <string>OpenRaster Image</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.image</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>ora</string></array>
        <key>public.mime-type</key>
        <array><string>image/openraster</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.photocraft.kra</string>
      <key>UTTypeDescription</key>
      <string>Krita Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.image</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>kra</string><string>krz</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-krita</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.photocraft.pdn</string>
      <key>UTTypeDescription</key>
      <string>Paint.NET Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.image</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>pdn</string></array>
        <key>public.mime-type</key>
        <array><string>image/x-paintnet</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.adobe.photoshop-large-image</string>
      <key>UTTypeDescription</key>
      <string>PSD Large Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>psb</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.photocraft.qoi</string>
      <key>UTTypeDescription</key>
      <string>QOI Image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>qoi</string></array>
      </dict>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PhotoCraft Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <!-- Alternate, not Owner: the .pcraft type is owned by the upstream bundle (see above), so
           claiming ownership from here would fight it for the default. Alternate puts this app in
           the "Open With" menu, which is all the edition promises. -->
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeIconFile</key>
      <string>PhotoCraft</string>
      <key>LSItemContentTypes</key>
      <array><string>ai.storyteller.photocraft.document</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PSD Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.photoshop-image</string>
        <string>com.adobe.photoshop-large-image</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Image</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.png</string>
        <string>public.jpeg</string>
        <string>public.tiff</string>
        <string>org.webmproject.webp</string>
        <string>com.compuserve.gif</string>
        <string>com.microsoft.bmp</string>
        <string>com.truevision.tga-image</string>
        <string>com.microsoft.ico</string>
        <string>public.pbm</string>
        <string>com.ilm.openexr-image</string>
        <string>public.radiance</string>
        <string>public.avif</string>
        <string>ai.storyteller.photocraft.qoi</string>
        <string>ai.storyteller.photocraft.pdn</string>
        <string>ai.storyteller.photocraft.ora</string>
        <string>ai.storyteller.photocraft.kra</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
