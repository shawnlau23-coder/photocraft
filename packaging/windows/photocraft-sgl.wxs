<?xml version="1.0" encoding="utf-8"?>
<!--
  "PhotoCraft with SGL Tools": the SGL build shipped from the pinned approved build inputs
  (.github/workflows/sgl-packages.yml), packaged to install ALONGSIDE an upstream PhotoCraft
  install, never to replace, upgrade or remove it.

  It is a separate product with its own upgrade family:
    - its own UpgradeCode, ProductCode and component GUIDs (Windows Installer matches upgrades
      only inside one UpgradeCode, so it can never replace an upstream PhotoCraft install);
    - its own install folders, Start menu entry, Add/Remove Programs entry, registry anchor
      (Software\PhotoCraft with SGL Tools) and ProgIDs (PhotocraftSGL.*);
    - no App Paths and no Software\Classes\Applications\photocraft.exe registration: those are
      keyed by the exe name, which the SGL build shares with upstream, and two products
      writing one key fight over it (last install wins, either uninstall deletes it). "Open
      with" still lists this product through its ProgIDs; the two ProgID families and both
      OpenWithProgids value sets coexist. .pcraft is offered but not claimed: the product never
      changes anyone's default app (unlike upstream, whose Photocraft.Document owns .pcraft).

  Keep the payload wiring in sync with photocraft.wxs (same binaries, same layout); only the
  identity, registrations and the install-policy edition defines differ.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <!-- install-policy.wxi edition defines: the folder leaf, the product's own registry anchor,
       and no App Paths/legacy-exe searches (the exe name is shared with upstream; see the
       comment in install-policy.wxi for why that would hijack the other product's folder). -->
  <?define ProductLeaf=PhotoCraft with SGL Tools?>
  <?define ProductRegKey=Software\PhotoCraft with SGL Tools?>
  <?define UseAppPathsSearch=no?>
  <Package Name="PhotoCraft with SGL Tools" Manufacturer="SGL Tools Edition" Version="$(var.Version)" UpgradeCode="967FF165-E6F5-4C33-81B1-4DCED5174EE9" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="PhotoCraft with SGL Tools image editor" Manufacturer="SGL Tools Edition" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Upgrades stay inside the SGL family: only other products with this UpgradeCode are
         ever replaced. AllowSameVersionUpgrades lets successive pre-releases of one X.Y.Z
         replace each other (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both
         1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of PhotoCraft with SGL Tools is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotocraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotocraftIcon.exe" />
    <!-- No ARPURLINFOABOUT/ARPURLUPDATEINFO/ARPHELPLINK: this is not the vendor's published
         product and must not advertise the vendor's support or update channels. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="PhotoCraft with SGL Tools" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous SGL copy (written by PhotocraftApp
       under Software\PhotoCraft with SGL Tools, never under the upstream key). -->

    <Feature Id="Main" Title="PhotoCraft with SGL Tools" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="PhotocraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotocraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photocraft-sgl.en-us.wxl. -->
    <Property Id="PhotocraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="PhotoCraft with SGL Tools $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PhotoCraft with SGL Tools" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotocraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotocraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="PhotocraftFiles" Directory="INSTALLFOLDER">
      <!-- Both component GUIDs are explicit and differ from the upstream components' GUIDs:
           the same GUID in two products would make Windows Installer treat them as one shared
           component. -->
      <Component Id="PhotocraftApp" Guid="8B50B562-973F-4CA8-B213-EF55E99EEDCC">
        <File Id="PhotocraftExe" Source="$(var.BinDir)\photocraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="PhotoCraft with SGL Tools" Description="PhotoCraft with SGL Tools image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="PhotocraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: offered for this product under "Open with", but never claimed as the
             default: Photocraft.Document (upstream) keeps the association, and installing this
             product changes no one's default app. -->
        <ProgId Id="PhotocraftSGL.Document" Description="PhotoCraft Document (SGL Tools edition)" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pcraft\OpenWithProgids" Name="PhotocraftSGL.Document" Value="" Type="string" />
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="PhotocraftSGL.PhotoshopDocument" Description="PSD Document (SGL Tools edition)" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\PhotocraftSGL.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="PhotocraftSGL.Image" Description="Image (SGL Tools edition)" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\PhotocraftSGL.Image\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="PhotocraftSGL.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="PhotocraftSGL.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="PhotocraftSGL.Image" Value="" Type="string" />

        <!-- No Software\Classes\Applications\photocraft.exe and no App Paths entry: both are
             keyed by the exe file name and shared with an upstream copy (see the file header). -->
        <RegistryValue Root="HKMU" Key="Software\PhotoCraft with SGL Tools" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotocraftCli" Guid="664EA033-7330-44BF-B315-0A7403CC0F79">
        <File Id="PhotocraftCliExe" Source="$(var.BinDir)\photocraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
